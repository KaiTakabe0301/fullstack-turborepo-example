# Local Environment Variables (Git-ignored)
# Copy this file to .env.local and fill in your local secrets
# .env.local will override values from .env

# PostgreSQL Database Configuration (Local)
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mydb?schema=public"

# Auth0 Configuration (Local)
# AUTH0_DOMAIN=your-dev-tenant.jp.auth0.com
# AUTH0_AUDIENCE=https://api.your-app.com

# Application Configuration (Optional overrides)
# NODE_ENV=development
# PORT=3001
# CORS_ORIGIN=http://localhost:3000
