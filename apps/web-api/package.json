{
  "name": "@repo/web-api",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsup src/runtime/node.ts --format esm --clean",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "node dist/node.js",
    "dev": "tsx watch --env-file=.env --env-file-if-exists=.env.local src/runtime/node.ts",
    "start:debug": "tsx watch --inspect src/runtime/node.ts",
    "lint": "eslint",
    "test": "vitest",
    "test:watch": "vitest watch",
    "test:cov": "vitest --coverage",
    "generate:openapi": "tsx scripts/generate-openapi.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.14.2",
    "@hono/swagger-ui": "^0.5.2",
    "@hono/zod-openapi": "^0.19.2",
    "@prisma/client": "^5.22.0",
    "@repo/database": "workspace:*",
    "hono": "^4.7.11",
    "jose": "^6.1.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/prettier-config": "workspace:*",
    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.8",
    "prisma": "^5.22.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "vitest": "^2.1.8"
  },
  "prettier": "@repo/prettier-config"
}
